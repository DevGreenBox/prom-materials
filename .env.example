# Avito API — выгрузка отзывов и рейтинга (scripts/fetch-avito-reviews.mjs).
# Значения лежат в .env.local, в репозиторий не попадают.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# СДЭК — расчёт доставки (lib/cdek.ts). Ключи интеграции из личного кабинета
# СДЭК: Настройки → Интеграция. Без них расчёт выключен, витрина предлагает
# самовывоз и расчёт через менеджера.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Тестовый контур: https://api.edu.cdek.ru/v2 (по умолчанию боевой).
CDEK_API=

# СДЭК — расчёт доставки (lib/cdek.ts, app/api/cdek/route.ts).
# Ключи интеграции из личного кабинета СДЭК. Пока их нет, блок доставки
# оставляет самовывоз и предлагает расчёт через менеджера.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Тестовый контур: https://api.edu.cdek.ru/v2 (по умолчанию боевой)
CDEK_API=
